+static bool layout_static_text(const char *text)
+{
+    const unsigned char *p = (const unsigned char *)text;
+    while (*p) {
+        if (*p == '}')
+            return false;
+        if (*p++ != '{')
+            continue;
+        do {
+            if (*p++ != '\\')
+                return false;
+            bool timing = *p == 'k' || *p == 'K';
+            bool alpha = false;
+            if (timing) {
+                bool lower = *p++ == 'k';
+                if (lower && (*p == 'f' || *p == 'o'))
+                    p++;
+                unsigned value = 0;
+                if (*p < '0' || *p > '9')
+                    return false;
+                do {
+                    value = value * 10 + (*p++ - '0');
+                    if (value > 1000000)
+                        return false;
+                } while (*p >= '0' && *p <= '9');
+            } else {
+                if (!strncmp((const char *)p, "alpha", 5)) {
+                    alpha = true;
+                    p += 5;
+                } else {
+                    bool numbered = *p >= '1' && *p <= '4';
+                    if (numbered)
+                        p++;
+                    if (*p != 'c' && !(numbered && *p == 'a'))
+                        return false;
+                    alpha = *p++ == 'a';
+                }
+                if (*p++ != '&' || *p++ != 'H')
+                    return false;
+                unsigned digits = 0;
+                while ((*p >= '0' && *p <= '9') ||
+                       (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F')) {
+                    p++;
+                    if (++digits > (alpha ? 2 : 6))
+                        return false;
+                }
+                if (!digits || *p++ != '&')
+                    return false;
+            }
+            if (*p != '\\' && *p != '}')
+                return false;
+        } while (*p != '}');
+        p++;
+    }
+    return true;
+}
+
+static bool layout_static_event(ASS_Track *track, int index)
+{
+    if (index < 0 || index >= track->n_events)
+        return false;
+    const ASS_Event *event = &track->events[index];
+    if (event->Style < 0 || event->Style >= track->n_styles || !event->Text ||
+        (event->Effect && event->Effect[0]))
+        return false;
+    const ASS_Style *style = &track->styles[event->Style];
+    if (!isfinite(style->Angle) || style->Angle != 0 ||
+        !isfinite(style->ScaleX) || style->ScaleX <= 0 ||
+        !isfinite(style->ScaleY) || style->ScaleY <= 0 ||
+        !style->FontName || style->FontName[0] == '@')
+        return false;
+    return layout_static_text(event->Text);
+}
