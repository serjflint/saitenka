diff --git a/sub/ass_layout_profile.h b/sub/ass_layout_profile.h
new file mode 100644
index 0000000000..19524cfa95
--- /dev/null
+++ b/sub/ass_layout_profile.h
@@ -0,0 +1,96 @@
+#ifndef MPV_ASS_LAYOUT_PROFILE_H
+#define MPV_ASS_LAYOUT_PROFILE_H
+#include <stdbool.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool layout_decimal(const unsigned char **cursor, double low, double high)
+{
+    const unsigned char *p = *cursor;
+    if (*p == '+' || *p == '-') p++;
+    unsigned digits = 0;
+    while (*p >= '0' && *p <= '9') { p++; digits++; }
+    if (*p == '.') {
+        p++;
+        while (*p >= '0' && *p <= '9') { p++; digits++; }
+    }
+    if (!digits || p - *cursor > 32) return false;
+    char *end;
+    double value = strtod((const char *)*cursor, &end);
+    if ((const unsigned char *)end != p || !isfinite(value) || value < low || value > high)
+        return false;
+    *cursor = p;
+    return true;
+}
+
+static bool layout_static_text(const char *text)
+{
+    const unsigned char *p = (const unsigned char *)text;
+    bool positioned = false;
+    while (*p) {
+        if (*p == '}')
+            return false;
+        if (*p++ != '{')
+            continue;
+        do {
+            if (*p++ != '\\')
+                return false;
+            bool timing = *p == 'k' || *p == 'K';
+            bool alpha = false;
+            if (!strncmp((const char *)p, "pos(", 4)) {
+                if (positioned) return false;
+                positioned = true;
+                p += 4;
+                if (!layout_decimal(&p, -1000000, 1000000) || *p++ != ',' ||
+                    !layout_decimal(&p, -1000000, 1000000) || *p++ != ')')
+                    return false;
+            } else if (!strncmp((const char *)p, "fscx", 4) ||
+                       !strncmp((const char *)p, "fscy", 4)) {
+                p += 4;
+                if (!layout_decimal(&p, 0.000001, 10000)) return false;
+            } else if (timing) {
+                bool lower = *p++ == 'k';
+                if (lower && (*p == 'f' || *p == 'o'))
+                    p++;
+                unsigned value = 0;
+                if (*p < '0' || *p > '9')
+                    return false;
+                do {
+                    value = value * 10 + (*p++ - '0');
+                    if (value > 1000000)
+                        return false;
+                } while (*p >= '0' && *p <= '9');
+            } else {
+                if (!strncmp((const char *)p, "alpha", 5)) {
+                    alpha = true;
+                    p += 5;
+                } else {
+                    bool numbered = *p >= '1' && *p <= '4';
+                    if (numbered)
+                        p++;
+                    if (*p != 'c' && !(numbered && *p == 'a'))
+                        return false;
+                    alpha = *p++ == 'a';
+                }
+                if (*p++ != '&' || *p++ != 'H')
+                    return false;
+                unsigned digits = 0;
+                while ((*p >= '0' && *p <= '9') ||
+                       (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F')) {
+                    p++;
+                    if (++digits > (alpha ? 2 : 8))
+                        return false;
+                }
+                if (!digits) return false;
+                if (*p == '&') p++;
+            }
+            if (*p != '\\' && *p != '}')
+                return false;
+        } while (*p != '}');
+        p++;
+    }
+    return true;
+}
+
+#endif
