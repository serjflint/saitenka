diff --git a/test/ass_layout_profile.c b/test/ass_layout_profile.c
new file mode 100644
index 0000000000..513175efb0
--- /dev/null
+++ b/test/ass_layout_profile.c
@@ -0,0 +1,23 @@
+#undef NDEBUG
+#include <assert.h>
+#include "sub/ass_layout_profile.h"
+
+int main(void)
+{
+    const char *valid[] = {
+        "text", "{\\pos(340,496)\\fscx50}A{\\fscx100}B",
+        "{\\pos(-5.5,+12)\\fscy150}M", "{\\c&H0000FFFF}yellow",
+        "{\\1c&HFFFF&}yellow", "{\\kf100}karaoke", "{\\alpha&H80&}alpha",
+    };
+    const char *invalid[] = {
+        "{\\pos(0,0)\\pos(1,1)}X", "{\\pos(1,)}X", "{\\pos(NaN,0)}X",
+        "{\\fscx0}X", "{\\fscy-1}X", "{\\fscxnan}X", "{\\fscx1e2}X",
+        "{\\t(\\fscx50)}X", "{\\clip(0,0,100,100)}X", "{\\move(1,2,3,4)}X",
+        "{\\frz5}X", "{\\rOther}X", "{\\c&H123456789}X", "{\\alpha&HFFF}X",
+        "{\\pos(1,2)", "}", "{\\p1}m 0 0 l 1 1", "{\\fscx}",
+    };
+    for (unsigned i = 0; i < sizeof(valid)/sizeof(valid[0]); i++)
+        assert(layout_static_text(valid[i]));
+    for (unsigned i = 0; i < sizeof(invalid)/sizeof(invalid[0]); i++)
+        assert(!layout_static_text(invalid[i]));
+}
