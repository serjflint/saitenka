{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/session-v0.json",
  "title": "Saitenka session compatibility scenario v0",
  "$defs": {
    "event": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["event", "name", "data"], "properties": {"event": {"const": "property-change"}, "name": {"type": "string"}, "data": {}}},
        {"type": "object", "additionalProperties": false, "required": ["event", "args"], "properties": {"event": {"const": "client-message"}, "args": {"type": "array", "items": {"type": "string"}}}}
      ]
    },
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"const": "start"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "events"], "properties": {"action": {"const": "emit_batch"}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "name"], "properties": {"action": {"const": "command"}, "name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "epoch"], "properties": {"action": {"enum": ["transport_lost", "transport_ready", "transport_replaced"]}, "epoch": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "max_steps"], "properties": {"action": {"const": "drain_until_quiescent"}, "max_steps": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"const": "close"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "name"], "properties": {"action": {"const": "checkpoint"}, "name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "count", "max_steps"], "properties": {"action": {"const": "await_notes"}, "count": {"type": "integer", "minimum": 1}, "max_steps": {"type": "integer", "minimum": 1}}}
      ]
    },
    "observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "value"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "command"}, "value": {"type": "array"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "text"], "properties": {"source": {"const": "clipboard"}, "kind": {"const": "write"}, "text": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind"], "properties": {"source": {"const": "adapter"}, "kind": {"const": "terminated"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "name"], "properties": {"source": {"const": "driver"}, "kind": {"const": "checkpoint"}, "name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "name", "flags", "binding_count", "unique_keys"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "binding-section"}, "name": {"type": "string"}, "flags": {"type": ["string", "null"]}, "binding_count": {"type": "integer", "minimum": 0}, "unique_keys": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "name"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "binding-section-enabled"}, "name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "legacy_keybind_count"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "binding-transport"}, "legacy_keybind_count": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "key", "section", "message", "status"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "binding"}, "key": {"type": "string"}, "section": {"type": "string"}, "message": {"type": "string"}, "status": {"const": "present"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "key", "status"], "properties": {"source": {"const": "mpv"}, "kind": {"const": "binding"}, "key": {"type": "string"}, "status": {"const": "absent"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "kind", "note"], "properties": {"source": {"const": "anki"}, "kind": {"const": "add-note"}, "note": {"type": "object"}}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "scenario_id", "requires", "given", "when", "expect"],
  "properties": {
    "protocol": {"const": "saitenka.session/v0"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "requires": {"const": ["session-v0"]},
    "given": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture": {"type": "array", "items": {"enum": ["observer", "surface", "termination", "clipboard", "notice", "seek", "checkpoint", "binding", "anki", "track"]}, "uniqueItems": true},
        "mpv_properties": {"type": "object"},
        "key_options": {"type": "object", "additionalProperties": false, "properties": {"help_key": {"type": "string"}, "hover_pause_key": {"type": "string"}, "sub_prev_key": {"type": "string"}, "sub_next_key": {"type": "string"}, "sub_replay_key": {"type": "string"}}},
        "capture_binding_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mining": {"type": "object", "additionalProperties": false, "required": ["config"], "properties": {"config": {"type": "object"}}}
      }
    },
    "when": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "observations"],
      "properties": {
        "mode": {"enum": ["exact", "contains_in_order"]},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      }
    }
  }
}
