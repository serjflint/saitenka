[
  {
    "scenario_id": "help-inventory",
    "mode": "inventory",
    "expect_contains": {
      "flags": [
        "--config", "--sub-file", "--slang", "--dict", "--translate-key", "--start",
        "--jimaku", "--jimaku-key", "--jimaku-title", "--episode", "--width", "--height",
        "--fullscreen", "--use-config", "--demo-word", "--demo-translate", "--demo-scroll",
        "--bulk", "--screenshot", "--seconds", "--color", "--known", "--anki-decks",
        "--freq", "--pitch", "--mine", "--mine-deck", "--mine-model", "--mine-key",
        "--mine-all-key", "--preview-key", "--no-audio-play", "--tip-height",
        "--pause-on-tooltip", "--no-prefetch", "--auto-translate", "--hover-switch-delay",
        "--no-resync"
      ],
      "commands": [
        "run", "doctor", "init", "import-settings", "install-plugin", "uninstall-plugin",
        "attach", "setup"
      ]
    }
  },
  {
    "scenario_id": "repeatable-resource-flags-preserve-order",
    "mode": "parse",
    "args": [
      "run", "--dict", "a.zip", "--dict", "b.zip", "--freq", "f.zip",
      "--pitch", "p.zip", "--pitch", "q.zip"
    ],
    "observe": ["dicts", "freq", "pitch"],
    "expect": {"dicts": ["a.zip", "b.zip"], "freq": ["f.zip"], "pitch": ["p.zip", "q.zip"]}
  },
  {
    "scenario_id": "negative-switches",
    "mode": "parse",
    "args": ["run", "--no-audio-play", "--no-prefetch", "--no-mine-preview"],
    "observe": ["no_audio_play", "prefetch", "mine_preview"],
    "expect": {"no_audio_play": true, "prefetch": false, "mine_preview": false}
  },
  {
    "scenario_id": "switch-defaults",
    "mode": "parse",
    "args": ["run"],
    "apply_defaults": true,
    "observe": ["no_audio_play", "prefetch", "mine_preview"],
    "expect": {"no_audio_play": false, "prefetch": true, "mine_preview": true}
  },
  {
    "scenario_id": "legacy-run-defaults",
    "mode": "parse",
    "args": ["run"],
    "apply_defaults": true,
    "observe": [
      "slang", "start", "width", "height", "seconds", "tip_height", "hover_switch_delay",
      "mine_deck", "mine_model", "mine_key", "mine_all_key", "translate_key", "preview_key",
      "video", "demo_scroll"
    ],
    "expect": {
      "slang": "ja,jpn,jp", "start": "1", "width": 1920, "height": 1080, "seconds": 60.0,
      "tip_height": 0.4, "hover_switch_delay": 0.15, "mine_deck": null, "mine_model": null,
      "mine_key": "Ctrl+m", "mine_all_key": "Shift+m", "translate_key": "t",
      "preview_key": "p", "video": null, "demo_scroll": 0
    }
  },
  {
    "scenario_id": "video-positional",
    "mode": "parse",
    "args": ["run", "/tmp/x.mkv"],
    "observe": ["video"],
    "expect": {"video": "/tmp/x.mkv"}
  },
  {
    "scenario_id": "toml-feeds-cli-defaults",
    "mode": "parse-config",
    "config": "slang = \"en,eng\"\ntip_height = 0.4\npause_on_tooltip = true\n",
    "args": ["run"],
    "observe": ["slang", "tip_height", "pause_on_tooltip"],
    "expect": {"slang": "en,eng", "tip_height": 0.4, "pause_on_tooltip": true}
  },
  {
    "scenario_id": "explicit-cli-wins-over-toml",
    "mode": "parse-config",
    "config": "slang = \"en,eng\"\n",
    "args": ["run", "--slang", "ja"],
    "observe": ["slang"],
    "expect": {"slang": "ja"}
  },
  {
    "scenario_id": "resource-name-precedence",
    "mode": "resolve-names",
    "cases": [
      {"flags": ["FlagDict"], "config": {"dicts": ["ConfigDict"]}, "key": "dicts"},
      {"flags": [], "config": {"dicts": ["ConfigDict"]}, "key": "dicts"},
      {"flags": null, "config": {}, "key": "dicts"}
    ],
    "expect": [["FlagDict"], ["ConfigDict"], []]
  },
  {
    "scenario_id": "jimaku-fetch-policy",
    "mode": "jimaku-decision",
    "cases": [
      {"explicit": true, "configured": false, "video": "v.mkv", "probe": true},
      {"explicit": true, "configured": true, "video": null, "probe": null},
      {"explicit": false, "configured": true, "video": "v.mkv", "probe": false},
      {"explicit": false, "configured": true, "video": "v.mkv", "probe": true},
      {"explicit": false, "configured": true, "video": "v.mkv", "probe": null},
      {"explicit": false, "configured": false, "video": "v.mkv", "probe": false}
    ],
    "expect": [true, false, true, false, true, false]
  }
]
