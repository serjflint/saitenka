  "native-geometry-version": [
    {
      "id": "mpv-version-0",
      "input": "mpv v0.40.0",
      "expected": true
    },
    {
      "id": "mpv-version-1",
      "input": "mpv 0.41.0",
      "expected": true
    },
    {
      "id": "mpv-version-2",
      "input": "mpv v0.39.0",
      "expected": false
    },
    {
      "id": "mpv-version-3",
      "input": "mpv v0.38.0",
      "expected": false
    },
    {
      "id": "mpv-version-4",
      "input": "mpv.net",
      "expected": false
    }
  ],
  "profile-commands": [
    {
      "id": "profile-cli-commands-0",
      "input": {
        "config": "dicts = [\"JP\"]\nfreq = [\"JPDB\"]\npitch = [\"NHK\"]\n",
        "args": [
          "profile",
          "add",
          "french",
          "--language",
          "fr",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "dicts": [
            "JP"
          ],
          "freq": [
            "JPDB"
          ],
          "pitch": [
            "NHK"
          ],
          "profiles": {
            "french": {
              "language": "fr",
              "tokenizer": "latin",
              "dicts": [],
              "freq": [],
              "pitch": []
            }
          }
        },
        "stdout": [
          "backed up existing config"
        ]
      }
    },
    {
      "id": "profile-cli-commands-1",
      "input": {
        "config": "dicts = [\"JP\"]\nfreq = [\"JPDB\"]\npitch = [\"NHK\"]\n",
        "args": [
          "profile",
          "add",
          "french",
          "--language",
          "fr",
          "--second",
          "en",
          "--dicts",
          "FR-EN",
          "--freq",
          "FR Freq",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "dicts": [
            "JP"
          ],
          "freq": [
            "JPDB"
          ],
          "pitch": [
            "NHK"
          ],
          "profiles": {
            "french": {
              "language": "fr",
              "tokenizer": "latin",
              "second": "en",
              "dicts": [
                "FR-EN"
              ],
              "freq": [
                "FR Freq"
              ],
              "pitch": []
            }
          }
        },
        "stdout": [
          "backed up existing config"
        ]
      }
    },
    {
      "id": "profile-cli-commands-2",
      "input": {
        "config": null,
        "args": [
          "profile",
          "add",
          "chinese",
          "--language",
          "zh",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": null,
        "error": "no default tokenizer for language 'zh'; set a profile tokenizer explicitly (e.g. tokenizer = \"latin\")",
        "config": null,
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-3",
      "input": {
        "config": null,
        "args": [
          "profile",
          "add",
          "chinese",
          "--language",
          "zh",
          "--tokenizer",
          "latin",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "profiles": {
            "chinese": {
              "language": "zh",
              "tokenizer": "latin",
              "dicts": [],
              "freq": [],
              "pitch": []
            }
          }
        },
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-4",
      "input": {
        "config": null,
        "args": [
          "profile",
          "add",
          "",
          "--language",
          "fr",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": null,
        "error": "profile name must be non-empty",
        "config": null,
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-5",
      "input": {
        "config": null,
        "args": [
          "profile",
          "add",
          "default",
          "--language",
          "fr",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": null,
        "error": "profile name 'default' is reserved for the built-in profile",
        "config": null,
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-6",
      "input": {
        "config": "active_profile = \"german\"\n",
        "args": [
          "profile",
          "use",
          "french",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "active_profile": "french"
        },
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-7",
      "input": {
        "config": "active_profile = \"german\"\n",
        "args": [
          "profile",
          "use",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "active_profile": ""
        },
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-8",
      "input": {
        "config": "active_profile = \"french\"\n[profiles.french]\n[profiles.german]\n",
        "args": [
          "profile",
          "remove",
          "french",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "profiles": {
            "german": {}
          }
        },
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-9",
      "input": {
        "config": "active_profile = \"german\"\n[profiles.french]\n[profiles.german]\n",
        "args": [
          "profile",
          "remove",
          "french",
          "--yes"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "active_profile": "german",
          "profiles": {
            "german": {}
          }
        },
        "stdout": []
      }
    },
    {
      "id": "profile-cli-commands-10",
      "input": {
        "config": "active_profile = \"french\"\n[profiles.german]\nlanguage = \"de\"\ntokenizer = \"latin\"\n[profiles.french]\nlanguage = \"fr\"\ntokenizer = \"latin\"\n",
        "args": [
          "profile",
          "list"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "active_profile": "french",
          "profiles": {
            "german": {
              "language": "de",
              "tokenizer": "latin"
            },
            "french": {
              "language": "fr",
              "tokenizer": "latin"
            }
          }
        },
        "stdout": [
          "  default          jp→en  [unidic]",
          "* french           fr→en  [latin]",
          "  german           de→en  [latin]"
        ]
      }
    },
    {
      "id": "profile-cli-commands-11",
      "input": {
        "config": "[profiles.french]\nlanguage = \"fr\"\ndicts = [\"FR-EN\"]\n",
        "args": [
          "profile",
          "show",
          "french"
        ]
      },
      "expected": {
        "exit_code": 0,
        "error": null,
        "config": {
          "profiles": {
            "french": {
              "language": "fr",
              "dicts": [
                "FR-EN"
              ]
            }
          }
        },
        "stdout": [
          "profile:   french",
          "language:  fr  (second: en)",
          "tokenizer: latin",
          "dicts:     FR-EN",
          "freq:      —",
          "pitch:     —"
        ]
      }
    }
  ],
  "parse": [
    {
      "id": "repeatable-resource-flags-preserve-order",
      "input": {
        "args": [
          "run",
          "--dict",
          "a.zip",
          "--dict",
          "b.zip",
          "--freq",
          "f.zip",
          "--pitch",
          "p.zip",
          "--pitch",
          "q.zip"
        ]
      },
      "expected": {
        "dicts": [
          "a.zip",
          "b.zip"
        ],
        "freq": [
          "f.zip"
        ],
        "pitch": [
          "p.zip",
          "q.zip"
        ]
      }
    },
    {
      "id": "negative-switches",
      "input": {
        "args": [
          "run",
          "--no-audio-play",
          "--no-prefetch",
          "--no-mine-preview"
        ]
      },
      "expected": {
        "no_audio_play": true,
        "prefetch": false,
        "mine_preview": false
      }
    },
    {
      "id": "switch-defaults",
      "input": {
        "args": [
          "run"
        ]
      },
      "expected": {
        "no_audio_play": false,
        "prefetch": true,
        "mine_preview": true
      }
    },
    {
      "id": "legacy-run-defaults",
      "input": {
        "args": [
          "run"
        ]
      },
      "expected": {
        "slang": "ja,jpn,jp",
        "start": "1",
        "width": 1920,
        "height": 1080,
        "seconds": 60.0,
        "tip_height": 0.4,
        "hover_switch_delay": 0.15,
        "mine_deck": null,
        "mine_model": null,
        "mine_key": "Ctrl+m",
        "mine_all_key": "Shift+m",
        "translate_key": "t",
        "preview_key": "p",
        "video": null,
        "demo_scroll": 0
      }
    },
    {
      "id": "video-positional",
      "input": {
        "args": [
          "run",
          "/tmp/x.mkv"
        ]
      },
      "expected": {
        "video": "/tmp/x.mkv"
      }
    }
  ],
  "parse-config": [
    {
      "id": "toml-feeds-cli-defaults",
      "input": {
        "config": "slang = \"en,eng\"\ntip_height = 0.4\npause_on_tooltip = true\n",
        "args": [
          "run"
        ]
      },
      "expected": {
        "slang": "en,eng",
        "tip_height": 0.4,
        "pause_on_tooltip": true
      }
    },
    {
      "id": "explicit-cli-wins-over-toml",
      "input": {
        "config": "slang = \"en,eng\"\n",
        "args": [
          "run",
          "--slang",
          "ja"
        ]
      },
      "expected": {
        "slang": "ja"
      }
    }
