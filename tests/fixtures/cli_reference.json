{
  "mpv-launch": [
    {
      "id": "mpv-launch-default",
      "input": {
        "binary": "mpv",
        "ipc_path": "/tmp/s.sock",
        "log_path": "/tmp/mpv.log",
        "video": "video.mkv",
        "options": {
          "slang": "jpn",
          "start": "1",
          "screenshot": false
        },
        "sub_path": null,
        "second_sub_path": null,
        "platform": "darwin"
      },
      "expected": [
        "mpv",
        "--force-window=yes",
        "--keep-open=yes",
        "--slang=jpn",
        "--sub-visibility=no",
        "--osd-level=1",
        "--start=1",
        "--sub-align-x=center",
        "--sub-justify=center",
        "--sub-ass-justify=yes",
        "--input-ipc-server=/tmp/s.sock",
        "--script-opts=saitenka-managed=yes",
        "--log-file=/tmp/mpv.log",
        "video.mkv"
      ]
    },
