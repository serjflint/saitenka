[
  {
    "scenario_id": "track-change-retires-cue-first",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0, "sid": 1},
      "installed": {"start": 1.0, "end": 3.0}
    },
    "when": [{"operation": "observe", "name": "sid", "value": 2}],
    "observe": ["identity", "installed"],
    "expect": {
      "events": [
        {"kind": "cue-retired", "reason": "track"},
        {"kind": "authored-cue-stale"},
        {"kind": "subtitle-selection", "track": 2, "sid": 2, "role": ""}
      ],
      "state": {
        "identity": {"source": 0, "track": 2, "role": "", "text": "cat", "start": 1.0, "end": 3.0, "cue": 1},
        "installed": false
      }
    }
  },
  {
    "scenario_id": "same-text-after-blank-is-new-cue",
    "given": {"seed": {"sub-text": "cat"}},
    "when": [
      {"operation": "observe", "name": "sub-text", "value": ""},
      {"operation": "observe", "name": "sub-text", "value": "cat"}
    ],
    "observe": ["identity"],
    "expect": {
      "events": [
        {"kind": "authored-cue-stale"},
        {"kind": "cue-observed", "identity": {"source": 0, "track": 0, "role": "", "text": "", "start": null, "end": null, "cue": 2}},
        {"kind": "authored-cue-stale"},
        {"kind": "cue-observed", "identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 3}}
      ],
      "state": {"identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 3}}
    }
  },
  {
    "scenario_id": "source-replacement-changes-identity",
    "given": {"seed": {"sub-text": "cat"}},
    "when": [{"operation": "source-replaced", "path": "/next.mkv"}],
    "observe": ["identity", "authored_stale"],
    "expect": {
      "events": [{"kind": "source-changed", "source": 1}],
      "state": {
        "identity": {"source": 1, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 1},
        "authored_stale": true
      }
    }
  },
  {
    "scenario_id": "same-sid-role-change-is-new-track",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0, "sid": 1},
      "installed": {"start": 1.0, "end": 3.0}
    },
    "when": [{"operation": "role-changed", "role": "second"}],
    "observe": ["identity", "installed"],
    "expect": {
      "events": [
        {"kind": "subtitle-selection", "track": 2, "sid": 1, "role": "second"},
        {"kind": "cue-retired", "reason": "role"}
      ],
      "state": {
        "identity": {"source": 0, "track": 2, "role": "second", "text": "cat", "start": 1.0, "end": 3.0, "cue": 1},
        "installed": false
      }
    }
  },
  {
    "scenario_id": "unchanged-role-is-inert",
    "given": {"prepare": [{"operation": "role-changed", "role": "jp"}]},
    "when": [{"operation": "role-changed", "role": "jp"}],
    "observe": ["identity"],
    "expect": {
      "events": [],
      "state": {"identity": {"source": 0, "track": 1, "role": "jp", "text": "", "start": null, "end": null, "cue": 0}}
    }
  },
  {
    "scenario_id": "local-clear-remains-authoritative",
    "given": {"seed": {"sub-text": "cat"}},
    "when": [
      {"operation": "cue-replaced", "text": ""},
      {"operation": "observe", "name": "sub-end", "value": 9.5}
    ],
    "observe": ["identity"],
    "expect": {
      "events": [
        {"kind": "cue-observed", "identity": {"source": 0, "track": 0, "role": "", "text": "", "start": null, "end": 9.5, "cue": 2}},
        {"kind": "geometry-input-changed", "property": "sub-end"}
      ],
      "state": {"identity": {"source": 0, "track": 0, "role": "", "text": "", "start": null, "end": 9.5, "cue": 2}}
    }
  },
  {
    "scenario_id": "old-text-is-observable-after-local-clear",
    "given": {
      "seed": {"sub-text": "cat"},
      "prepare": [{"operation": "cue-replaced", "text": ""}]
    },
    "when": [{"operation": "observe", "name": "sub-text", "value": "cat"}],
    "observe": ["identity"],
    "expect": {
      "events": [
        {"kind": "authored-cue-stale"},
        {"kind": "cue-observed", "identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 3}}
      ],
      "state": {"identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 3}}
    }
  },
  {
    "scenario_id": "unchanged-local-cue-is-inert",
    "given": {"seed": {"sub-text": "cat"}},
    "when": [{"operation": "cue-replaced", "text": "cat"}],
    "observe": ["identity"],
    "expect": {
      "events": [],
      "state": {"identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": null, "end": null, "cue": 1}}
    }
  },
  {
    "scenario_id": "older-epoch-observation-is-inert",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0},
      "installed": {"start": 1.0, "end": 3.0},
      "prepare": [{"operation": "connection-changed", "epoch": 2, "ready": true}]
    },
    "when": [{"operation": "observe", "name": "sub-text", "value": "dog", "connection_epoch": 1}],
    "observe": ["identity", "connection"],
    "expect": {
      "events": [],
      "state": {
        "identity": {"source": 0, "track": 0, "role": "", "text": "cat", "start": 1.0, "end": 3.0, "cue": 1},
        "connection": {"epoch": 2, "ready": true}
      }
    }
  },
  {
    "scenario_id": "replacement-retires-before-ready",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0},
      "installed": {"start": 1.0, "end": 3.0}
    },
    "when": [{"operation": "connection-changed", "epoch": 1, "ready": true}],
    "observe": ["installed", "connection"],
    "expect": {
      "events": [
        {"kind": "cue-retired", "reason": "connection"},
        {"kind": "connection-changed", "epoch": 1, "ready": true}
      ],
      "state": {"installed": false, "connection": {"epoch": 1, "ready": true}}
    }
  },
  {
    "scenario_id": "connection-loss-retires-cue",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0},
      "installed": {"start": 1.0, "end": 3.0}
    },
    "when": [{"operation": "connection-changed", "epoch": 0, "ready": false}],
    "observe": ["installed", "connection"],
    "expect": {
      "events": [
        {"kind": "cue-retired", "reason": "connection"},
        {"kind": "connection-changed", "epoch": 0, "ready": false}
      ],
      "state": {"installed": false, "connection": {"epoch": 0, "ready": false}}
    }
  },
  {
    "scenario_id": "replay-cannot-resurrect-retired-cue",
    "given": {
      "seed": {"sub-text": "cat", "sub-start": 1.0, "sub-end": 3.0},
      "installed": {"start": 1.0, "end": 3.0},
      "prepare": [{"operation": "connection-changed", "epoch": 0, "ready": false}]
    },
    "when": [
      {"operation": "observe", "name": "sub-text", "value": "cat"},
      {"operation": "observe", "name": "sub-start", "value": 1.0},
      {"operation": "observe", "name": "sub-end", "value": 3.0}
    ],
    "observe": ["installed"],
    "expect": {"events": [], "state": {"installed": false}}
  },
  {
    "scenario_id": "render-space-observation-revises-geometry",
    "given": {},
    "when": [{"operation": "observe", "name": "osd-dimensions", "value": {"w": 1920, "h": 1080}}],
    "observe": ["render_space"],
    "expect": {
      "events": [
        {"kind": "render-space-changed", "revision": 1, "property": "osd-dimensions"},
        {"kind": "geometry-input-changed", "property": "osd-dimensions"}
      ],
      "state": {"render_space": 1}
    }
  },
  {
    "scenario_id": "cue-timing-does-not-revise-space",
    "given": {},
    "when": [{"operation": "observe", "name": "sub-start", "value": 4.0}],
    "observe": ["identity", "render_space"],
    "expect": {
      "events": [
        {"kind": "cue-observed", "identity": {"source": 0, "track": 0, "role": "", "text": "", "start": 4.0, "end": null, "cue": 0}},
        {"kind": "geometry-input-changed", "property": "sub-start"}
      ],
      "state": {
        "identity": {"source": 0, "track": 0, "role": "", "text": "", "start": 4.0, "end": null, "cue": 0},
        "render_space": 0
      }
    }
  },
  {
    "scenario_id": "subtitle-delay-is-timing-only",
    "given": {},
    "when": [{"operation": "observe", "name": "sub-delay", "value": 0.5}],
    "observe": ["delay", "render_space"],
    "expect": {
      "events": [{"kind": "subtitle-timing-changed", "delay": 0.5}],
      "state": {"delay": 0.5, "render_space": 0}
    }
  }
]
