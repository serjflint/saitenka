{
  "protocol": "saitenka.session/v0",
  "scenario_id": "loss-suspends-command-until-replacement",
  "requires": ["session-v0"],
  "given": {
    "capture": ["surface", "checkpoint", "termination"],
    "mpv_properties": {
      "sub-text": "current",
      "sid": 1,
      "sub-start": 1.0,
      "sub-end": 2.0,
      "osd-dimensions": {"w": 1280, "h": 720}
    }
  },
  "when": [
    {"action": "start"},
    {"action": "transport_lost", "epoch": 0},
    {"action": "command", "name": "saitenka-toggle-help"},
    {"action": "checkpoint", "name": "lost-command-finished"},
    {"action": "transport_ready", "epoch": 1},
    {"action": "transport_replaced", "epoch": 1},
    {"action": "drain_until_quiescent", "max_steps": 8},
    {"action": "command", "name": "saitenka-toggle-help"},
    {"action": "checkpoint", "name": "recovered-command-finished"}
  ],
  "expect": {
    "mode": "exact",
    "observations": [
      {"source": "driver", "kind": "checkpoint", "name": "lost-command-finished"},
      {"source": "mpv", "kind": "command", "value": ["surface-present", "surface-1"]},
      {"source": "driver", "kind": "checkpoint", "name": "recovered-command-finished"},
      {"source": "mpv", "kind": "command", "value": ["surface-absent", "surface-1"]},
      {"source": "adapter", "kind": "terminated"}
    ]
  }
}

