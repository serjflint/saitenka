{
  "protocol": "saitenka.session/v0",
  "scenario_id": "input-registration-publishes-effective-bindings",
  "requires": ["session-v0"],
  "given": {
    "capture": ["binding", "termination"],
    "mpv_properties": {},
    "key_options": {
      "help_key": "Ctrl+h",
      "hover_pause_key": "Ctrl+q",
      "sub_prev_key": "Ctrl+1",
      "sub_next_key": "Ctrl+2",
      "sub_replay_key": "Ctrl+3"
    },
    "capture_binding_keys": ["Ctrl+h", "F1", "Ctrl+q", "Ctrl+1", "Ctrl+2", "Ctrl+3", "MBTN_LEFT", "WHEEL_UP", "z", "Z", "x"]
  },
  "when": [
    {"action": "start"}
  ],
  "expect": {
    "mode": "contains_in_order",
    "observations": [
      {"source": "mpv", "kind": "binding-section-enabled", "name": "saitenka-global"},
      {"source": "mpv", "kind": "binding-transport", "legacy_keybind_count": 0},
      {"source": "mpv", "kind": "binding-section", "name": "saitenka-global", "flags": "force", "binding_count": 25, "unique_keys": true},
      {"source": "mpv", "kind": "binding-section", "name": "saitenka-mouse", "flags": "force", "binding_count": 4, "unique_keys": true},
      {"source": "mpv", "kind": "binding", "key": "Ctrl+h", "section": "saitenka-global", "message": "saitenka-toggle-help", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "F1", "status": "absent"},
      {"source": "mpv", "kind": "binding", "key": "Ctrl+q", "section": "saitenka-global", "message": "saitenka-toggle-hover-pause", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "Ctrl+1", "section": "saitenka-global", "message": "saitenka-sub-prev", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "Ctrl+2", "section": "saitenka-global", "message": "saitenka-sub-next", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "Ctrl+3", "section": "saitenka-global", "message": "saitenka-sub-replay", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "MBTN_LEFT", "section": "saitenka-mouse", "message": "saitenka-click", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "WHEEL_UP", "section": "saitenka-mouse", "message": "saitenka-scroll-up", "status": "present"},
      {"source": "mpv", "kind": "binding", "key": "z", "status": "absent"},
      {"source": "mpv", "kind": "binding", "key": "Z", "status": "absent"},
      {"source": "mpv", "kind": "binding", "key": "x", "status": "absent"},
      {"source": "adapter", "kind": "terminated"}
    ]
  }
}
