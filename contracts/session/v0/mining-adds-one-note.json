{
  "protocol": "saitenka.session/v0",
  "scenario_id": "mining-adds-one-note",
  "requires": ["session-v0"],
  "given": {
    "capture": ["anki", "termination"],
    "mpv_properties": {
      "path": "/x/[Grp] Show - 03 [1080p].mkv",
      "time-pos": 63,
      "sub-text": "読む",
      "sid": 1,
      "sub-start": 60.0,
      "sub-end": 64.0
    },
    "mining": {
      "config": {
        "card_format": {"Word": "{expression}"}
      }
    }
  },
  "when": [
    {"action": "start"},
    {"action": "drain_until_quiescent", "max_steps": 16},
    {"action": "command", "name": "saitenka-mine-all"},
    {"action": "await_notes", "count": 1, "max_steps": 200}
  ],
  "expect": {
    "mode": "contains_in_order",
    "observations": [
      {
        "source": "anki",
        "kind": "add-note",
        "note": {
          "deckName": "Saitenka::Mining",
          "modelName": "Lapis",
          "fields": {"Word": "読む", "IsWordAndSentenceCard": "1"},
          "tags": ["saitenka", "saitenka::mined", "saitenka::source::Show", "saitenka::ep::03"],
          "options": {"allowDuplicate": false}
        }
      },
      {"source": "adapter", "kind": "terminated"}
    ]
  }
}
