{
  "protocol": "saitenka.session/v0",
  "scenario_id": "language-toggle-returns-to-primary",
  "requires": ["session-v0"],
  "given": {
    "capture": ["track", "termination"],
    "mpv_properties": {
      "track-list": [
        {"id": 1, "type": "sub", "lang": "eng", "selected": true},
        {"id": 2, "type": "sub", "lang": "jpn", "selected": false}
      ],
      "sid": 1,
      "sub-text": "hello",
      "sub-start": 1.0,
      "sub-end": 2.0
    }
  },
  "when": [
    {"action": "start"},
    {"action": "drain_until_quiescent", "max_steps": 8},
    {"action": "command", "name": "saitenka-toggle-subtitle-language"}
  ],
  "expect": {
    "mode": "exact",
    "observations": [
      {"source": "mpv", "kind": "command", "value": ["set-property", "secondary-sid", "no"]},
      {"source": "mpv", "kind": "command", "value": ["set-property", "sid", 2]},
      {"source": "adapter", "kind": "terminated"}
    ]
  }
}
