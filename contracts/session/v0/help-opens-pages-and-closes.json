{
  "protocol": "saitenka.session/v0",
  "scenario_id": "help-opens-pages-and-closes",
  "requires": ["session-v0"],
  "given": {
    "capture": ["surface", "notice", "termination"],
    "mpv_properties": {"osd-dimensions": {"w": 480, "h": 220}}
  },
  "when": [
    {"action": "start"},
    {"action": "command", "name": "saitenka-toggle-help"},
    {"action": "command", "name": "saitenka-toggle-overlay"},
    {"action": "command", "name": "saitenka-help-next"},
    {"action": "command", "name": "saitenka-help-close"}
  ],
  "expect": {
    "mode": "exact",
    "observations": [
      {"source": "mpv", "kind": "command", "value": ["surface-present", "surface-1"]},
      {"source": "mpv", "kind": "command", "value": ["surface-present", "surface-1"]},
      {"source": "mpv", "kind": "command", "value": ["surface-absent", "surface-1"]},
      {"source": "mpv", "kind": "command", "value": ["surface-absent", "surface-1"]},
      {"source": "adapter", "kind": "terminated"}
    ]
  }
}
