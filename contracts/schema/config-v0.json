{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/config-v0.json",
  "title": "Saitenka configuration compatibility scenario v0",
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "config", "flags", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "run"}, "config": {"type": "object"}, "flags": {"type": "object"}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "config", "mine", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "attach"}, "config": {"type": "object"}, "mine": {"type": "object"}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "fields", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "editor-catalog"}, "fields": {"type": "array", "items": {"type": "string"}}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "checks", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"enum": ["editor-defaults", "editor-coerce"]}, "checks": {"type": "array", "items": {"type": "object"}}, "expect": {"type": "array"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "configs", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "mine-model"}, "configs": {"type": "array", "items": {"type": "object"}}, "expect": {"type": "array"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "scoped_config", "cli", "observe", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "run-effective"}, "scoped_config": {"type": "object"}, "cli": {"type": "object"}, "observe": {"type": "array", "items": {"type": "string"}}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "initial", "edits", "observe_comments", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "editor-session"}, "initial": {"type": ["string", "null"]}, "edits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["section", "field", "value"], "properties": {"section": {"type": "string"}, "field": {"type": "string"}, "value": {"type": ["string", "null"]}}}}, "observe_comments": {"type": "array", "items": {"type": "string"}}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "config", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "profile-identity"}, "config": {"type": "object"}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "cases", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"enum": ["profile-policy", "config-policy"]}, "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "expect": {"type": "array"}}
    }
  ]
}
