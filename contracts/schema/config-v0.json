{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/config-v0.json",
  "title": "Saitenka configuration compatibility scenario v0",
  "type": "object",
  "required": ["scenario_id", "mode", "expect"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "mode": {"enum": ["run", "attach", "editor-catalog", "editor-defaults", "editor-coerce", "mine-model", "run-effective"]},
    "config": {"type": "object"},
    "flags": {"type": "object"},
    "mine": {"type": "object"},
    "fields": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "object"}},
    "configs": {"type": "array", "items": {"type": "object"}},
    "scoped_config": {"type": "object"},
    "cli": {"type": "object"},
    "observe": {"type": "array", "items": {"type": "string"}},
    "expect": {}
  },
  "additionalProperties": false
}
