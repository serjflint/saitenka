{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/subtitle-v0.json",
  "title": "Saitenka subtitle rendering compatibility scenario v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "mode", "cases", "expect"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "enum": ["render-inputs", "renderer-state", "selection-policy", "navigation-policy", "provider-policy", "artifact-policy"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "expect": {
      "type": "array",
      "minItems": 1
    }
  }
}
