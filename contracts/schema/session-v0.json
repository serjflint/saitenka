{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/session-v0.json",
  "title": "Saitenka session compatibility scenario v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "scenario_id", "requires", "given", "when", "expect"],
  "properties": {
    "protocol": {"const": "saitenka.session/v0"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "given": {"type": "object"},
    "when": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"const": "start"}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "events"], "properties": {"action": {"const": "emit_batch"}, "events": {"type": "array", "items": {"type": "object"}}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "name"], "properties": {"action": {"const": "command"}, "name": {"type": "string"}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "epoch"], "properties": {"action": {"enum": ["transport_lost", "transport_ready", "transport_replaced"]}, "epoch": {"type": "integer", "minimum": 0}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "max_steps"], "properties": {"action": {"const": "drain_until_quiescent"}, "max_steps": {"type": "integer", "minimum": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"const": "close"}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "name"], "properties": {"action": {"const": "checkpoint"}, "name": {"type": "string"}}}
        ]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "observations"],
      "properties": {
        "mode": {"enum": ["exact", "contains_in_order"]},
        "observations": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
