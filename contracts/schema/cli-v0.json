{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saitenka.dev/contracts/schema/cli-v0.json",
  "title": "Saitenka CLI compatibility scenario v0",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "args": {"type": "array", "items": {"type": "string"}},
    "observe": {"type": "array", "items": {"type": "string"}}
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "expect_contains"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "inventory"}, "expect_contains": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "args", "observe", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "parse"}, "args": {"$ref": "#/$defs/args"}, "observe": {"$ref": "#/$defs/observe"}, "apply_defaults": {"type": "boolean"}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "config", "args", "observe", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"const": "parse-config"}, "config": {"type": "string"}, "args": {"$ref": "#/$defs/args"}, "observe": {"$ref": "#/$defs/observe"}, "expect": {"type": "object"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "mode", "cases", "expect"],
      "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "mode": {"enum": ["resolve-names", "jimaku-decision"]}, "cases": {"type": "array", "items": {"type": "object"}}, "expect": {"type": "array"}}
    }
  ]
}
