[
  {
    "scenario_id": "editor-session-preserves-comments-and-untouched-values",
    "mode": "editor-session",
    "initial": "# my hand-written config\nslang = \"ja,jpn,jp\"  # keep me\n\n[mine]\ndeck = \"Saitenka::Mining\"\n",
    "edits": [
      {"section": "tooltip", "field": "tip_scale", "value": "2.5"},
      {"section": "keys", "field": "key", "value": "Ctrl+n"}
    ],
    "observe_comments": ["# my hand-written config", "# keep me"],
    "expect": {
      "exit_code": 0,
      "exists": true,
      "config": {
        "slang": "ja,jpn,jp",
        "tip_scale": 2.5,
        "mine": {"deck": "Saitenka::Mining", "key": "Ctrl+n"}
      },
      "comments": {"# my hand-written config": true, "# keep me": true}
    }
  },
  {
    "scenario_id": "editor-session-with-no-edits-writes-nothing",
    "mode": "editor-session",
    "initial": null,
    "edits": [],
    "observe_comments": [],
    "expect": {"exit_code": 0, "exists": false, "config": null, "comments": {}}
  },
  {
    "scenario_id": "editor-session-preserves-a-sibling-default",
    "mode": "editor-session",
    "initial": "[dictdb]\nmmap_size = 111\ncache_size_kib = 222\ndexie_chunk_size = 333\n",
    "edits": [
      {"section": "dictdb", "field": "mmap_size", "value": "999"},
      {"section": "dictdb", "field": "cache_size_kib", "value": null}
    ],
    "observe_comments": [],
    "expect": {
      "exit_code": 0,
      "exists": true,
      "config": {"dictdb": {"mmap_size": 999, "cache_size_kib": 222, "dexie_chunk_size": 333}},
      "comments": {}
    }
  }
]
