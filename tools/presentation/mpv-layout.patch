+        ASS_LayoutUnit unit = {.text_start = 0, .logical_bounds = {0}};
+        if (event.units || unit.text_start)
+            return 1;
+        const ASS_RenderResult *result = ass_render_frame2(0, &request);
+        return result && result->layout_status == ASS_LAYOUT_OK;
+    }
+''', name: 'compatible libass subtitle layout API', dependencies: libass)
