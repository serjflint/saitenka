+    layout->space_mt = dim.mt;
+    layout->space_mb = dim.mb;
+    layout->space_ml = dim.ml;
+    layout->space_mr = dim.mr;
+    layout->space_display_par = dim.display_par;
+    layout->events = talloc_zero_array(layout, struct sub_layout_event, num_events);
