+    for (ASS_LayoutEvent *event = source->events; event; event = event->next) {
+        if (++num_events > SUB_LAYOUT_MAX_EVENTS)
+            goto limit;
+    }
+
+    size_t total = sizeof(struct sub_layout);
+    const char *format = source_format ? source_format : "unknown";
+    if (!layout_account(&total, num_events, sizeof(struct sub_layout_event)) ||
+        !layout_account(&total, strlen(format) + 1, 1))
+        goto limit;
+
+    layout = talloc_zero(NULL, struct sub_layout);
+    layout->unit_mode = source->unit_mode ==
