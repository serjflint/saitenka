+#if HAVE_LIBASS_LAYOUT
+static void node_array_add_string(struct mpv_node *array, const char *value)
+{
+    struct mpv_node *entry = node_array_add(array, MPV_FORMAT_NONE);
+    entry->format = MPV_FORMAT_STRING;
+    entry->u.string = talloc_strdup(array->u.list, value);
+}
+#endif
+
+static void node_add_layout_rect(struct mpv_node *map, const char *key,
+                                 struct sub_layout_rect rect)
+{
+    struct mpv_node *out = node_map_add(map, key, MPV_FORMAT_NODE_MAP);
+    node_map_add_double(out, "x", rect.x);
+    node_map_add_double(out, "y", rect.y);
+    node_map_add_double(out, "w", rect.w);
+    node_map_add_double(out, "h", rect.h);
+}
+
+static void node_array_add_layout_rect(struct mpv_node *array,
+                                       struct sub_layout_rect rect)
+{
+    struct mpv_node *out = node_array_add(array, MPV_FORMAT_NODE_MAP);
+    node_map_add_double(out, "x", rect.x);
+    node_map_add_double(out, "y", rect.y);
+    node_map_add_double(out, "w", rect.w);
+    node_map_add_double(out, "h", rect.h);
+}
+
+static const char *subtitle_layout_origin_name(enum osd_render_origin origin)
+{
+    switch (origin) {
+    case OSD_RENDER_PRESENTATION: return "output-render";
+    case OSD_RENDER_SUB_FILTER_PRESENTATION: return "sub-filter-render";
+    case OSD_RENDER_CAPTURE: return "capture";
+    case OSD_RENDER_INTERMEDIATE: return "intermediate";
+    case OSD_RENDER_STEREO: return "stereo";
+    case OSD_RENDER_PROBE: return "probe";
+    }
+    return "unknown";
+}
+
+static const char *subtitle_layout_status_name(enum sub_layout_status status)
+{
+    switch (status) {
+    case SUB_LAYOUT_NONE: return "no-authoritative-render";
+    case SUB_LAYOUT_OK: return "ok";
+    case SUB_LAYOUT_EMPTY: return "empty";
+    case SUB_LAYOUT_LIMIT_EXCEEDED: return "limit-exceeded";
+    case SUB_LAYOUT_COLLECTION_FAILED: return "collection-failed";
+    case SUB_LAYOUT_COPY_REJECTED: return "collection-failed";
+    case SUB_LAYOUT_UNSUPPORTED: return "unsupported-build";
+    case SUB_LAYOUT_UNSUPPORTED_FORMAT: return "unsupported-format";
+    case SUB_LAYOUT_UNSUPPORTED_RENDER_MODE: return "unsupported-render-mode";
+    }
+    return "unknown";
+}
+
+static bool subtitle_layout_snapshot_is_current(
+    MPContext *mpctx, struct subtitle_layout_snapshot *snapshot)
+{
+    struct track *track = mpctx->current_track[0][STREAM_SUB];
+    int64_t playlist_entry_id = mpctx->playing ? mpctx->playing->id : -1;
+    return snapshot->layout && track &&
+           track->user_tid == snapshot->track_id &&
+           playlist_entry_id == snapshot->playlist_entry_id;
+}
+
+static void cmd_subtitle_layout_valid(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    MPContext *mpctx = cmd->mpctx;
+    struct subtitle_layout_snapshot snapshot;
+    osd_get_subtitle_layout_metadata(mpctx->osd, &snapshot);
+    bool valid = subtitle_layout_snapshot_is_current(mpctx, &snapshot);
+    if (valid) {
+        char snapshot_id[96];
+        snprintf(snapshot_id, sizeof(snapshot_id), "g%" PRIu64 "-r%" PRIu64,
+                 snapshot.decoder_generation, snapshot.revision);
+        valid = strcmp(snapshot_id, cmd->args[0].v.s) == 0;
+    }
+    cmd->result = (struct mpv_node) {
+        .format = MPV_FORMAT_FLAG,
+        .u.flag = valid,
+    };
+}
+
+static void cmd_subtitle_layout(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    MPContext *mpctx = cmd->mpctx;
+    struct mpv_node *root = &cmd->result;
+    node_init(root, MPV_FORMAT_NODE_MAP, NULL);
+
+#if HAVE_LIBASS_LAYOUT
+    struct mpv_node *capabilities =
+        node_map_add(root, "capabilities", MPV_FORMAT_NODE_ARRAY);
+    node_array_add_string(capabilities, "events");
+    node_array_add_string(capabilities, "unit-logical-rects");
+    node_array_add_string(capabilities, "event-geometry-profile");
+    node_array_add_string(capabilities, "event-track-index");
+    node_array_add_string(capabilities, "event-bitmap-bounds");
+    struct mpv_node *limits =
+        node_map_add(root, "limits", MPV_FORMAT_NODE_MAP);
+    node_map_add_int64(limits, "max_events", SUB_LAYOUT_MAX_EVENTS);
+    node_map_add_int64(limits, "max_text_bytes", SUB_LAYOUT_MAX_TEXT_BYTES);
+    node_map_add_int64(limits, "max_units", SUB_LAYOUT_MAX_UNITS);
+    node_map_add_int64(limits, "max_bitmap_pixels",
+                       SUB_LAYOUT_MAX_BITMAP_PIXELS);
+    node_map_add_int64(limits, "max_retained_bytes",
+                       SUB_LAYOUT_MAX_RETAINED_BYTES);
+#else
+    node_map_add(root, "capabilities", MPV_FORMAT_NODE_ARRAY);
+    node_map_add(root, "limits", MPV_FORMAT_NODE_MAP);
+#endif
+
+    if (!mpctx->opts->subs_rend->subtitle_layout) {
+        node_map_add_flag(root, "available", false);
+        node_map_add_string(root, "status", "disabled");
+        node_map_add_int64(root, "revision",
+                           osd_get_subtitle_layout_revision(mpctx->osd));
+        return;
+    }
+
+#if !HAVE_LIBASS_LAYOUT
+    node_map_add_flag(root, "available", false);
+    node_map_add_string(root, "status", "unsupported-build");
+    node_map_add_int64(root, "revision",
+                       osd_get_subtitle_layout_revision(mpctx->osd));
+    return;
+#else
+    struct track *track = mpctx->current_track[0][STREAM_SUB];
+    if (track && track->d_sub && !sub_uses_libass(track->d_sub)) {
+        node_map_add_flag(root, "available", false);
+        node_map_add_string(root, "status", "unsupported-format");
+        node_map_add_int64(root, "revision",
+                           osd_get_subtitle_layout_revision(mpctx->osd));
+        return;
+    }
+#endif
+
+    struct subtitle_layout_snapshot *snapshot =
+        osd_get_subtitle_layout_snapshot(NULL, mpctx->osd);
+    if (!snapshot->layout) {
+        node_map_add_flag(root, "available", false);
+        node_map_add_string(root, "status",
+                            subtitle_layout_status_name(snapshot->status));
+        node_map_add_int64(root, "revision", snapshot->revision);
+        talloc_free(snapshot);
+        return;
+    }
+
+    const struct sub_layout *layout = snapshot->layout;
+    if (!subtitle_layout_snapshot_is_current(mpctx, snapshot)) {
+        talloc_free(snapshot);
+        node_map_add_flag(root, "available", false);
+        node_map_add_string(root, "status", "stale-identity");
+        node_map_add_int64(root, "revision",
+            osd_get_subtitle_layout_revision(mpctx->osd));
+        return;
+    }
+    node_map_add_flag(root, "available", true);
+    node_map_add_string(root, "status", "ok");
+    node_map_add_int64(root, "revision", snapshot->revision);
+    char snapshot_id[96];
+    snprintf(snapshot_id, sizeof(snapshot_id), "g%" PRIu64 "-r%" PRIu64,
+             snapshot->decoder_generation, snapshot->revision);
+    node_map_add_string(root, "snapshot_id", snapshot_id);
+
+    struct mpv_node *media = node_map_add(root, "media", MPV_FORMAT_NODE_MAP);
+    node_map_add_int64(media, "playlist_entry_id", snapshot->playlist_entry_id);
+
+    struct mpv_node *track_node = node_map_add(root, "track", MPV_FORMAT_NODE_MAP);
+    node_map_add_int64(track_node, "id", snapshot->track_id);
+    node_map_add_int64(track_node, "decoder_generation",
+                       snapshot->decoder_generation);
+    node_map_add_string(track_node, "format", layout->source_format);
+    node_map_add_string(track_node, "layout_engine", "libass");
+    node_map_add_string(track_node, "layout_unit_mode",
+        layout->unit_mode == SUB_LAYOUT_UNIT_SIMPLE_SCALAR
+        ? "simple-scalar" : "harfbuzz-cluster");
+
+    struct mpv_node *time = node_map_add(root, "time", MPV_FORMAT_NODE_MAP);
+    node_map_add_double(time, "render_video_pts", snapshot->video_pts);
+    node_map_add_double(time, "render_subtitle_pts", layout->subtitle_pts);
+    node_map_add_string(time, "event_domain", "subtitle");
+
+    struct mpv_node *space = node_map_add(root, "space", MPV_FORMAT_NODE_MAP);
+    node_map_add_string(space, "name", "osd");
