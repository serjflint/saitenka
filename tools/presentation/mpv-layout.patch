+
+struct subtitle_layout_ref {
+    atomic_uint refcount;
+    struct sub_layout *layout;
+};
+
+static struct subtitle_layout_ref *subtitle_layout_ref_new(
+    const struct sub_layout *layout)
+{
+    struct subtitle_layout_ref *ref =
+        talloc_zero(NULL, struct subtitle_layout_ref);
+    atomic_init(&ref->refcount, 1);
+    ref->layout = sub_layout_copy(ref, layout);
+    if (!ref->layout) {
+        talloc_free(ref);
+        return NULL;
+    }
+    return ref;
+}
+
+static void subtitle_layout_ref_add(struct subtitle_layout_ref *ref)
+{
+    if (ref)
+        atomic_fetch_add_explicit(&ref->refcount, 1, memory_order_relaxed);
+}
+
+static void subtitle_layout_ref_release(struct subtitle_layout_ref *ref)
+{
+    if (ref && atomic_fetch_sub_explicit(&ref->refcount, 1,
+                                         memory_order_acq_rel) == 1)
+        talloc_free(ref);
+}
+
+static struct sub_layout *retained_subtitle_layout(struct osd_state *osd)
+{
+    return osd->subtitle_layout ? osd->subtitle_layout->layout : NULL;
+}
+
+static bool sub_layout_rect_equal(const struct sub_layout_rect *a,
+                                  const struct sub_layout_rect *b)
+{
+    return a->x == b->x && a->y == b->y && a->w == b->w && a->h == b->h;
+}
+
+static bool sub_layout_equal(const struct sub_layout *a,
+                             enum osd_render_origin a_origin,
+                             const struct sub_layout *b,
+                             enum osd_render_origin b_origin)
+{
+    if (a_origin != b_origin || a->unit_mode != b->unit_mode ||
+        strcmp(a->source_format, b->source_format) != 0 ||
+        a->space_w != b->space_w || a->space_h != b->space_h ||
+        a->space_mt != b->space_mt || a->space_mb != b->space_mb ||
+        a->space_ml != b->space_ml || a->space_mr != b->space_mr ||
+        a->space_display_par != b->space_display_par ||
+        a->num_events != b->num_events)
+        return false;
+
+    for (int n = 0; n < a->num_events; n++) {
+        const struct sub_layout_event *ae = &a->events[n];
+        const struct sub_layout_event *be = &b->events[n];
+        if (ae->text_length != be->text_length ||
+            (ae->text_length && memcmp(ae->text, be->text, ae->text_length)) ||
+            ae->start != be->start || ae->end != be->end ||
+            ae->has_bitmap_bounds != be->has_bitmap_bounds ||
+            ae->static_logical_profile != be->static_logical_profile ||
+            ae->track_index != be->track_index ||
+            !sub_layout_rect_equal(&ae->bitmap_bounds, &be->bitmap_bounds) ||
+            ae->num_units != be->num_units)
+            return false;
+
+        for (int c = 0; c < ae->num_units; c++) {
+            const struct sub_layout_unit *au = &ae->units[c];
+            const struct sub_layout_unit *bu = &be->units[c];
+            if (au->text_start != bu->text_start ||
+                au->text_end != bu->text_end || au->line != bu->line ||
+                !sub_layout_rect_equal(&au->logical_bounds,
+                                       &bu->logical_bounds))
+                return false;
+
+        }
+    }
+    return true;
+}
+
+// Caller holds osd->lock.
+static void publish_subtitle_layout(struct osd_state *osd,
+                                    const struct sub_layout *layout,
+                                    enum sub_layout_status status,
+                                    double video_pts,
+                                    enum osd_render_origin origin)
+{
+    if (!layout) {
+        bool changed = osd->subtitle_layout ||
+                       osd->subtitle_layout_status != status;
+        if (!changed)
+            return;
+        subtitle_layout_ref_release(osd->subtitle_layout);
+        osd->subtitle_layout = NULL;
+        osd->subtitle_layout_status = status;
+        atomic_fetch_add(&osd->subtitle_layout_revision, 1);
+        return;
+    }
+
+    if (osd->subtitle_layout &&
+        sub_layout_equal(osd->subtitle_layout->layout,
+                         osd->subtitle_layout_origin, layout, origin))
+        return;
+
+    struct subtitle_layout_ref *copy = subtitle_layout_ref_new(layout);
+    if (!copy)
+        return;
+    subtitle_layout_ref_release(osd->subtitle_layout);
+    osd->subtitle_layout = copy;
+    osd->subtitle_layout_video_pts = video_pts;
+    osd->subtitle_layout_origin = origin;
+    osd->subtitle_layout_status = SUB_LAYOUT_OK;
+    atomic_fetch_add(&osd->subtitle_layout_revision, 1);
+}
+
+// Caller holds osd->lock. Explicit state transitions must remain observable
+// even when there is no retained layout to clear.
+static void invalidate_subtitle_layout(struct osd_state *osd)
+{
+    uint64_t revision = atomic_load(&osd->subtitle_layout_revision);
+    publish_subtitle_layout(osd, NULL, SUB_LAYOUT_NONE, MP_NOPTS_VALUE,
+                            OSD_RENDER_PROBE);
+    if (atomic_load(&osd->subtitle_layout_revision) == revision)
+        atomic_fetch_add(&osd->subtitle_layout_revision, 1);
+}
