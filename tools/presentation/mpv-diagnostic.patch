--- /dev/null
+++ b/common/frame_diag.c
@@ -0,0 +1,85 @@
+#include "common/frame_diag.h"
+#include "osdep/timer.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define SK_ROWS 65536
+struct row { atomic_bool ready; char text[768]; };
+static struct row *rows;
+static char *path;
+static pthread_once_t once = PTHREAD_ONCE_INIT;
+static atomic_uint cursor;
+static atomic_ullong composition_serial;
+static _Thread_local unsigned long long composition;
+
+static void flush(void)
+{
+    if (!rows) return;
+    FILE *out = fopen(path, "w");
+    if (!out) { perror("frame diagnostic"); return; }
+    unsigned n = atomic_load(&cursor), complete = 0;
+    for (unsigned i = 0; i < n && i < SK_ROWS; i++) {
+        if (atomic_load(&rows[i].ready)) {
+            fputs(rows[i].text, out);
+            fputc('\n', out);
+            complete++;
+        }
+    }
+    fprintf(out, "# health recorded=%u attempted=%u overflow=%u\n", complete, n,
+            n > SK_ROWS ? n - SK_ROWS : 0);
+    fclose(out);
+}
+static void init(void)
+{
+    const char *p = getenv("SAITENKA_MPV_TRACE");
+    if (!p || !*p) return;
+    path = strdup(p);
+    rows = calloc(SK_ROWS, sizeof(*rows));
+    if (rows) atexit(flush);
+}
+bool sk_diag_enabled(void)
+{
+    pthread_once(&once, init);
+    return rows != NULL;
+}
+uint64_t sk_diag_hash(const char *text)
+{
+    uint64_t hash = UINT64_C(14695981039346656037);
+    if (text) for (const unsigned char *p = (const unsigned char *)text; *p; p++) {
+        hash ^= *p;
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+void sk_diag(const char *tag, const char *fmt, ...)
+{
+    if (!sk_diag_enabled()) return;
+    unsigned i = atomic_fetch_add(&cursor, 1);
+    if (i >= SK_ROWS) return;
+    struct timespec wall;
+    int64_t mono = mp_time_ns();
+    clock_gettime(CLOCK_REALTIME, &wall);
+    char detail[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(detail, sizeof(detail), fmt, args);
+    va_end(args);
+    snprintf(rows[i].text, sizeof(rows[i].text),
+             "%lld %lld %llu %s %s", (long long)mono,
+             (long long)wall.tv_sec * 1000000000LL + wall.tv_nsec,
+             composition, tag, detail);
+    atomic_store(&rows[i].ready, true);
+}
+void sk_diag_begin(uint64_t frame, double pts, int64_t target, bool redraw)
+{
+    if (!sk_diag_enabled()) return;
+    composition = atomic_fetch_add(&composition_serial, 1) + 1;
+    sk_diag("draw_begin", "frame=%llu pts=%.9f target=%lld redraw=%d",
+            (unsigned long long)frame, pts, (long long)target, redraw);
+}
+void sk_diag_end(void) { composition = 0; }
