+    double rc[4] = {0};
+    struct osd_external_ass ov = {
+        .owner = cmd->cmd->sender,
+        .id = cmd->args[0].v.i64,
+        .format = 1,
+        .data = cmd->args[3].v.s,
+        .res_x = cmd->args[4].v.i,
+        .res_y = cmd->args[5].v.i,
+        .z = cmd->args[6].v.i,
+        .timed = true,
+        .start_ms = start,
+        .end_ms = end,
+        .out_rc = rc,
+    };
+    osd_set_external(mpctx->osd, &ov);
+    mp_wakeup_core(mpctx);
 }
 
