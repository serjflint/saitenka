+#pragma once
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+static inline bool osd_interval_valid(int64_t start, int64_t end)
+{
+    return start < end && start >= -(INT64_C(1) << 52) &&
+           end <= (INT64_C(1) << 52);
+}
+
+static inline bool osd_interval_active(int64_t start, int64_t end, double pts)
+{
+    if (!isfinite(pts) || !osd_interval_valid(start, end))
+        return false;
+    // Match native ASS's millisecond quantization.
+    double ms = floor(pts * 1000 + 1e-6);
+    return ms >= start && ms < end;
+}
