--- /dev/null
+++ b/test/osd_timing.c
@@ -0,0 +1,22 @@
+#include "test_utils.h"
+#include "sub/osd_timing.h"
+
+int main(void)
+{
+    assert_false(osd_interval_active(16120, 17000, 16.119));
+    assert_true(osd_interval_active(16120, 17000, 16.120));
+    assert_true(osd_interval_active(16120, 17000, 16.9999));
+    assert_false(osd_interval_active(16120, 17000, 17.000));
+    assert_false(osd_interval_active(16120, 17000, NAN));
+    assert_false(osd_interval_active(16120, 17000, INFINITY));
+    assert_false(osd_interval_active(16120, 17000, MP_NOPTS_VALUE));
+    assert_false(osd_interval_valid(1, 1));
+    assert_false(osd_interval_valid(2, 1));
+    assert_false(osd_interval_valid(INT64_MIN, INT64_MAX));
+    // Selection is stateless across backwards seeks and touching intervals.
+    assert_true(osd_interval_active(16120, 17000, 16.5));
+    assert_false(osd_interval_active(17000, 18000, 16.5));
+    assert_true(osd_interval_active(17000, 18000, 17.0));
+    assert_false(osd_interval_active(16120, 17000, 17.0));
+    return 0;
+}
