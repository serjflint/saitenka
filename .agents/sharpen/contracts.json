{
  "version": 5,
  "lifecycle": {
    "inner_reflection_receipt": "axes_not_applied",
    "outer_reflection_cadence": 3,
    "description": "Every ledger append carries axis evidence; after three audits the next audit is blocked until a human-approved outer reflection is recorded."
  },
  "select": {
    "type": "object",
    "additionalProperties": false,
    "required": ["found", "module", "tests", "status", "survival", "score", "conformance", "actionable", "pr_exclusion_checked", "outer_reflection_due", "reason"],
    "properties": {
      "found": {"type": "boolean"},
      "module": {"type": "string"},
      "tests": {"type": "array", "items": {"type": "string"}},
      "status": {"type": "string"},
      "survival": {"type": ["number", "null"]},
      "score": {"type": "number"},
      "conformance": {"type": "integer"},
      "actionable": {"type": "integer"},
      "pr_exclusion_checked": {"type": "boolean"},
      "outer_reflection_due": {"type": "boolean"},
      "reason": {"type": "string"}
    }
  },
  "record": {
    "type": "object",
    "additionalProperties": false,
    "required": ["state", "ledger_appended", "recorded_module", "recorded_source_sha", "recorded_toolset_version", "recorded_contract_version", "recorded_axes_not_applied"],
    "properties": {
      "state": {"type": "string", "enum": ["sharpened", "in-progress", "blocked-on-bug", "dry-run", "left-undone"]},
      "ledger_appended": {"type": "boolean"},
      "recorded_module": {"type": "string"},
      "recorded_source_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "recorded_toolset_version": {"type": "integer", "minimum": 1},
      "recorded_contract_version": {"type": "integer"},
      "recorded_axes_not_applied": {"type": "boolean"},
      "pr_url": {"type": ["string", "null"]},
      "grow_issues": {"type": "array", "items": {"type": "string"}},
      "note": {"type": "string"}
    }
  },
  "proposal": {
    "type": "object",
    "additionalProperties": false,
    "required": ["applied", "test_file", "cut_module", "touched_func", "preservation_required", "witness_find", "witness_replace", "diff", "proposals"],
    "properties": {
      "applied": {"type": "boolean"},
      "test_file": {"type": "string"},
      "cut_module": {"type": "string"},
      "touched_func": {"type": "string"},
      "preservation_required": {"type": "boolean", "description": "true when an existing assertion is removed or changed without a campaign"},
      "witness_find": {"type": ["string", "null"], "description": "exact source snippet for the pre-existing kill witness"},
      "witness_replace": {"type": ["string", "null"], "description": "scenario-breaking replacement for the witness"},
      "diff": {"type": "string"},
      "reason": {"type": ["string", "null"]},
      "proposals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_test", "axis", "change", "rationale"],
          "properties": {
            "target_test": {"type": "string"},
            "axis": {"type": "string"},
            "change": {"type": "string"},
            "rationale": {"type": "string"},
            "claimed_kills": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "ship_gate": {
    "type": "object",
    "additionalProperties": false,
    "required": ["pass", "report"],
    "properties": {
      "pass": {"type": "boolean"},
      "report": {"type": "string"}
    }
  },
  "review": {
    "type": "object",
    "additionalProperties": false,
    "required": ["verdict", "grounds", "constructed_bug", "better_fix"],
    "properties": {
      "verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]},
      "grounds": {"type": "array", "items": {"type": "string"}},
      "constructed_bug": {"type": ["string", "null"]},
      "better_fix": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["summary", "scope", "evidence"],
        "properties": {
          "summary": {"type": "string"},
          "scope": {"type": "string", "enum": ["target-test", "outside-sharpen"]},
          "evidence": {"type": "string"}
        }
      }
    }
  },
  "review_provenance": {
    "type": "object",
    "additionalProperties": false,
    "required": ["author", "skeptic", "judge", "skeptic_verdict", "judge_verdict", "verdict"],
    "properties": {
      "author": {"type": "string"},
      "skeptic": {"type": "string"},
      "judge": {"type": ["string", "null"]},
      "skeptic_verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]},
      "judge_verdict": {"type": ["string", "null"], "enum": ["UPHELD", "REFUTED", null]},
      "verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]}
    }
  }
}
