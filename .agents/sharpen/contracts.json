{
  "version": 3,
  "proposal": {
    "type": "object",
    "additionalProperties": false,
    "required": ["applied", "test_file", "cut_module", "touched_func", "preservation_required", "witness_find", "witness_replace", "diff", "proposals"],
    "properties": {
      "applied": {"type": "boolean"},
      "test_file": {"type": "string"},
      "cut_module": {"type": "string"},
      "touched_func": {"type": "string"},
      "preservation_required": {"type": "boolean", "description": "true when an existing assertion is removed or changed without a campaign"},
      "witness_find": {"type": ["string", "null"], "description": "exact source snippet for the pre-existing kill witness"},
      "witness_replace": {"type": ["string", "null"], "description": "scenario-breaking replacement for the witness"},
      "diff": {"type": "string"},
      "reason": {"type": ["string", "null"]},
      "proposals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_test", "axis", "change", "rationale"],
          "properties": {
            "target_test": {"type": "string"},
            "axis": {"type": "string"},
            "change": {"type": "string"},
            "rationale": {"type": "string"},
            "claimed_kills": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "review": {
    "type": "object",
    "additionalProperties": false,
    "required": ["verdict", "grounds", "constructed_bug", "better_fix"],
    "properties": {
      "verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]},
      "grounds": {"type": "array", "items": {"type": "string"}},
      "constructed_bug": {"type": ["string", "null"]},
      "better_fix": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["summary", "scope", "evidence"],
        "properties": {
          "summary": {"type": "string"},
          "scope": {"type": "string", "enum": ["target-test", "outside-sharpen"]},
          "evidence": {"type": "string"}
        }
      }
    }
  },
  "review_provenance": {
    "type": "object",
    "additionalProperties": false,
    "required": ["author", "skeptic", "judge", "skeptic_verdict", "judge_verdict", "verdict"],
    "properties": {
      "author": {"type": "string"},
      "skeptic": {"type": "string"},
      "judge": {"type": ["string", "null"]},
      "skeptic_verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]},
      "judge_verdict": {"type": ["string", "null"], "enum": ["UPHELD", "REFUTED", null]},
      "verdict": {"type": "string", "enum": ["UPHELD", "REFUTED"]}
    }
  }
}
